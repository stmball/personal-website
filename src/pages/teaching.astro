---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Teaching | ${SITE_TITLE}`} description="Teaching and supervision by Samuel Ball." />
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">Teaching & supervision</p>
			<h1>Teaching</h1>
			<section>
				<h2>PhD students</h2>
				<p>I welcome enquiries from prospective PhD students interested in deep learning for medical imaging, uncertainty-aware AI, interpretable machine learning, and health data science.</p>
				<p><a href="mailto:Samuel.Ball@liverpool.ac.uk">Get in touch to discuss a project idea →</a></p>
			</section>
			<section>
				<h2>Postgraduate teaching</h2>
				<div class="teaching-item">
					<p class="label">Module co-ordinator · 2025–26</p>
					<h3>Artificial Intelligence and Machine Learning for Health</h3>
					<p>DASC512 introduces postgraduate students to the principles and applications of AI and machine learning in health contexts.</p>
				</div>
			</section>
			<section>
				<h2>Presentations</h2>
				<p>I present on clinically useful AI, uncertainty in medical imaging, and reproducible approaches to health data science. A selection of slides and recordings will be added here.</p>
			</section>
		</main>
		<style>
			.eyebrow, .label { color: var(--accent); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
			section { max-width: 42rem; margin-top: 3rem; }
			section h2 { font-size: 1.5rem; }
			.teaching-item { margin-top: 1rem; padding: 1.5rem; border-left: 3px solid var(--accent); background: #f4faf6; }
			.teaching-item p { margin: 0.5rem 0 0; }
			.teaching-item h3 { margin: 0; }
		</style>
	</body>
</html>
