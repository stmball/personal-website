---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description="Research and community projects by Samuel Ball." />
	</head>
	<body>
		<Header />
		<main>
			<p class="eyebrow">Research & community</p>
			<h1>Projects</h1>
			<div class="projects">
				<article class="project">
					<div class="project-image oct" aria-hidden="true"><span>OCT</span><i></i><i></i><i></i></div>
					<div>
						<h2>OCT-Assist</h2>
						<p>OCT-Assist develops interpretable AI for optical coherence tomography imaging. The project brings clinical and AI expertise together to create models that are accurate, explainable, and useful in practice.</p>
					</div>
				</article>
				<article class="project reverse">
					<div class="project-image gan" aria-hidden="true"><span>GAN</span><i></i><i></i><i></i><i></i></div>
					<div>
						<h2>DeepGANnel</h2>
						<p>DeepGANnel uses generative adversarial networks to create fully annotated single-molecule patch-clamp data. It supports the development and evaluation of machine-learning approaches for electrophysiological signals.</p>
					</div>
				</article>
				<article class="project">
					<div class="project-image hipy" aria-hidden="true"><span>HiPy</span><i></i><i></i><i></i></div>
					<div>
						<h2>HiPy</h2>
						<p>HiPy is a grassroots programming community that supports people learning Python. Through accessible, collaborative events, it has helped thousands of students and staff build confidence in coding.</p>
					</div>
				</article>
			</div>
		</main>
		<style>
			.eyebrow { color: var(--accent); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
			.projects { display: grid; gap: 4rem; margin-top: 2rem; }
			.project { display: grid; grid-template-columns: 2fr 3fr; gap: 2rem; align-items: center; }
			.project.reverse .project-image { order: 2; }
			.project h2 { font-size: 1.75rem; }
			.project-image { position: relative; display: flex; min-height: 15rem; align-items: center; justify-content: center; overflow: hidden; background: #dff2e8; color: var(--accent); font-size: 2rem; font-weight: 700; letter-spacing: -0.08em; }
			.project-image i { position: absolute; display: block; border: 2px solid currentColor; border-radius: 50%; opacity: 0.45; }
			.oct i:nth-of-type(1) { width: 145%; height: 35%; }
			.oct i:nth-of-type(2) { width: 120%; height: 55%; }
			.oct i:nth-of-type(3) { width: 95%; height: 75%; }
			.gan { background: #e5f0ea; }
			.gan i { width: 1rem; height: 1rem; background: var(--accent); border: 0; }
			.gan i:nth-of-type(1) { transform: translate(-5rem, -3rem); }
			.gan i:nth-of-type(2) { transform: translate(4rem, -2rem); }
			.gan i:nth-of-type(3) { transform: translate(-3rem, 3rem); }
			.gan i:nth-of-type(4) { transform: translate(5rem, 4rem); }
			.hipy { background: #edf6f0; }
			.hipy i { width: 7rem; height: 7rem; }
			.hipy i:nth-of-type(1) { transform: translate(-4rem, -2rem); }
			.hipy i:nth-of-type(2) { transform: translate(4rem, -2rem); }
			.hipy i:nth-of-type(3) { transform: translate(0, 4rem); }
			@media (max-width: 720px) { .project, .project.reverse { display: block; } .project.reverse .project-image { order: unset; } .project-image { margin-bottom: 1.5rem; min-height: 12rem; } }
		</style>
	</body>
</html>
