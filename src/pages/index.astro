---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { Image } from 'astro:assets';
import me from '../assets/me.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="home">
				<div class="home-copy">
          <h1>Samuel Ball, Lecturer in Health Data Science</h1>
					<p>
						I’m a health data scientist based at the University of Liverpool, working at the
						intersection of artificial intelligence, data, and healthcare.
					</p>
					<p>
						My work focuses on developing and evaluating AI models, and applying existing methods to
						practical healthcare problems. I’m interested in building robust, clinically useful tools
						that improve how health data is understood and used.
					</p>
					<p>
						This site is a place to share my work, writing, and the ideas I’m exploring.
					</p>
				</div>
				<div class="home-image">
					<Image
						src={me}
						alt="Portrait of Sam Ball"
						width={480}
						height={480}
						fit="cover"
						position="right"
						format="webp"
					/>
				</div>
			</section>
		</main>
		<style>
			.home {
				display: grid;
				grid-template-columns: 3fr 2fr;
				gap: 3rem;
				align-items: center;
			}

			.home-copy h1 {
				font-size: clamp(2.5rem, 5vw, 3.75rem);
				letter-spacing: -0.04em;
			}

			.home-image {
				position: relative;
				aspect-ratio: 1;
			}

			.home-image img {
				display: block;
				width: 100%;
				height: 100%;
			}

			@media (max-width: 720px) {
				.home { display: block; }
				.home-image { display: none; }
			}
		</style>
	</body>
</html>
